===     Expect A=11110101=245, B=11111011=251, 245+251=496, S=1 at cycle 9. ===
  $ yosys -p "read_verilog results/warmup/sky130_models.v results/warmup/extracted_netlist.v;         hierarchy -top adder_demo_extracted; proc; flatten; async2sync; opt;         sat -seq 9 -set-init-zero -set rst_n 1 -set en 1 -set-at 9 S 1             -show A -show B -show S" > results/warmup/bmc_solve.log 2>&1 || true
  $ grep -E '^ +[0-9]+ .(A|B|S) ' results/warmup/bmc_solve.log      | awk '{printf "    cycle %2s  %s = %s\n", $1, substr($2,2), $3}'
    cycle  1  A = 1
    cycle  1  B = 1
    cycle  1  S = 0
    cycle  2  A = 1
    cycle  2  B = 1
    cycle  2  S = 0
    cycle  3  A = 1
    cycle  3  B = 1
    cycle  3  S = 0
    cycle  4  A = 1
    cycle  4  B = 1
    cycle  4  S = 0
    cycle  5  A = 0
    cycle  5  B = 1
    cycle  5  S = 0
    cycle  6  A = 1
    cycle  6  B = 0
    cycle  6  S = 0
    cycle  7  A = 0
    cycle  7  B = 1
